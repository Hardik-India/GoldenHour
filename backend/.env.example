# ---------- Server ----------
NODE_ENV=development
PORT=8000
CLIENT_URL=http://localhost:3000

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/goldenhour

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Matching rules ----------
RESPONDER_RADIUS_KM=3
DONOR_RADIUS_KM=15
AMBULANCE_RADIUS_KM=15
HOSPITAL_RADIUS_KM=25
MAX_RESPONDERS_NOTIFIED=15
DONOR_COOLDOWN_DAYS=90
AVG_URBAN_SPEED_KMPH=25

# ---------- Demo seed data (change to your city so the demo shows nearby responders) ----------
DEMO_CENTER_LAT=28.6139
DEMO_CENTER_LNG=77.2090
SEED_ADMIN_EMAIL=admin@goldenhour.app
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Emergency numbers shown in the app ----------
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
